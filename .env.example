# Local prototype only. Keep real keys out of this file.
DATABASE_URL=postgresql://localhost:55432/global_x402
PORT=3000
# Local development bearer tokens, NOT wallet authentication.
DEV_BUYER_TOKEN=
DEV_FILLER_TOKEN=

# Chainlink CRE verifier (VERIFIER=CRE runs workflows/cre-verify via `cre workflow simulate`)
VERIFIER=
CRE_VERIFIER_TOKEN=
# Escrow windows in minutes (pay-by must leave room for Masumi indexing; result window covers checkout + email)
ESCROW_PAY_WINDOW_MIN=25
ESCROW_RESULT_WINDOW_MIN=45
